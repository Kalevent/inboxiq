{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base"],
  "schedule": ["at any time"],
  "prConcurrentLimit": 5,

  "pip-compile": {
    "fileMatch": ["(^|/)requirements-inboxiq\\.txt$"]
  },

  "packageRules": [
    {
      "description": "All pip dependency PRs require review — lock file is regenerated by pip-compile manager",
      "matchManagers": ["pip_requirements", "pip-compile"],
      "addLabels": ["dependencies"],
      "automerge": false,
      "matchUpdateTypes": ["patch", "minor", "major"]
    },

    {
      "description": "OpenTelemetry packages must move together — core, instrumentation and semantic-conventions are tightly coupled",
      "matchManagers": ["pip_requirements", "pip-compile"],
      "matchPackagePatterns": ["^opentelemetry"],
      "groupName": "opentelemetry",
      "automerge": false
    },

    {
      "description": "fastmcp and py-key-value-aio are coupled — fastmcp pins the py-key-value-aio minor version",
      "matchManagers": ["pip_requirements", "pip-compile"],
      "matchPackageNames": ["fastmcp", "py-key-value-aio", "py-key-value-shared"],
      "groupName": "fastmcp",
      "automerge": false
    },

    {
      "description": "litellm pins ALL its dependencies with exact == versions. Group them so they always move together and never conflict.",
      "matchManagers": ["pip_requirements", "pip-compile"],
      "matchPackageNames": [
        "litellm",
        "dspy-ai",
        "aiohttp",
        "click",
        "openai",
        "httpx",
        "pydantic",
        "tiktoken",
        "tokenizers",
        "python-dotenv",
        "jsonschema",
        "importlib-metadata",
        "fastuuid"
      ],
      "groupName": "litellm and pinned deps",
      "automerge": false
    },

    {
      "description": "litellm must stay at 1.83.7 — only Python 3.14-compatible CVE-fixed version; 1.83.8+ declare Requires-Python: <3.14 which breaks our Docker build",
      "matchManagers": ["pip_requirements", "pip-compile"],
      "matchPackageNames": ["litellm"],
      "allowedVersions": "==1.83.7"
    },

    {
      "description": "Security patches on safe packages can automerge once lock file is consistent",
      "matchManagers": ["pip_requirements", "pip-compile"],
      "matchUpdateTypes": ["patch"],
      "matchPackageNames": ["PyJWT", "cryptography", "requests", "stripe"],
      "automerge": true
    },

    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "addLabels": ["dependencies", "ci"],
      "automerge": true,
      "matchUpdateTypes": ["patch", "minor"]
    },

    {
      "description": "Never auto-update major versions of core framework packages",
      "matchPackageNames": ["flask", "sqlalchemy", "celery", "rich", "gunicorn"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },

    {
      "matchPackageNames": ["aws-actions/configure-aws-credentials"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
