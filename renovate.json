{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base"],
  "schedule": ["at any time"],
  "prConcurrentLimit": 5,

  "pip-compile": {
    "fileMatch": ["src/requirements-inboxiq\\.txt$"],
    "lockFiles": ["src/requirements-inboxiq.lock.txt"]
  },

  "packageRules": [
    {
      "description": "All pip dependency PRs require review — lock file is regenerated by pip-compile manager",
      "matchManagers": ["pip_requirements", "pip-compile"],
      "addLabels": ["dependencies"],
      "automerge": false,
      "matchUpdateTypes": ["patch", "minor", "major"]
    },

    {
      "description": "OpenTelemetry packages must move together — core, instrumentation and semantic-conventions are tightly coupled",
      "matchManagers": ["pip_requirements", "pip-compile"],
      "matchPackagePatterns": ["^opentelemetry"],
      "groupName": "opentelemetry",
      "automerge": false
    },

    {
      "description": "fastmcp and py-key-value-aio are coupled — fastmcp pins the py-key-value-aio minor version",
      "matchManagers": ["pip_requirements", "pip-compile"],
      "matchPackageNames": ["fastmcp", "py-key-value-aio", "py-key-value-shared"],
      "groupName": "fastmcp",
      "automerge": false
    },

    {
      "description": "Security patches on safe packages can automerge once lock file is consistent",
      "matchManagers": ["pip_requirements", "pip-compile"],
      "matchUpdateTypes": ["patch"],
      "matchPackageNames": ["PyJWT", "cryptography", "requests", "aiohttp", "stripe"],
      "automerge": true
    },

    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "addLabels": ["dependencies", "ci"],
      "automerge": true,
      "matchUpdateTypes": ["patch", "minor"]
    },

    {
      "description": "Never auto-update major versions of core framework packages",
      "matchPackageNames": ["flask", "sqlalchemy", "celery", "rich", "gunicorn"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },

    {
      "matchPackageNames": ["aws-actions/configure-aws-credentials"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
