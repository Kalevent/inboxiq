
# --- builder ---
FROM python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /usr/src

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /usr/src/.venv
ENV PATH="/usr/src/.venv/bin:$PATH"

COPY src/requirements-inboxiq.lock.txt /usr/src/requirements-inboxiq.lock.txt
RUN pip install --no-cache-dir --no-compile -r /usr/src/requirements-inboxiq.lock.txt

# --- runtime ---
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    WORKDIR=/usr/src \
    PATH="/usr/src/.venv/bin:$PATH" \
    FLASK_APP=src.manage:app \
    PYTHONPATH=/usr/src

WORKDIR /usr/src

# Create non-root user
RUN addgroup --system appgroup && adduser --system --ingroup appgroup appuser

# Copy venv from builder
COPY --from=builder /usr/src/.venv /usr/src/.venv

# Copy application
COPY src /usr/src/src

# Copy lead discovery scripts
COPY find_automation_studio_leads.py find_leads_simple.py /usr/src/

# Fix ownership
RUN chown -R appuser:appgroup /usr/src

USER appuser

# Default command: gunicorn serving the app factory
CMD [ "gunicorn", "-b", "0.0.0.0:8000", "src.app:create_app()" ]


