# syntax=docker/dockerfile:1
# --- builder ---
FROM python:3.14-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /usr/src

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /usr/src/.venv
ENV PATH="/usr/src/.venv/bin:$PATH"

COPY src/requirements-inboxiq.lock.txt /usr/src/requirements-inboxiq.lock.txt
RUN pip install --no-cache-dir --no-compile -r /usr/src/requirements-inboxiq.lock.txt

# --- runtime ---
FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    WORKDIR=/usr/src \
    PATH="/usr/src/.venv/bin:$PATH" \
    FLASK_APP=src.manage:app \
    PYTHONPATH=/usr/src

WORKDIR /usr/src

# Create non-root user with a real home directory so DSPy cache (and other
# tools that write to $HOME) don't crash with [Errno 13] /nonexistent.
RUN addgroup --system appgroup && \
    adduser --system --ingroup appgroup --home /home/appuser --shell /bin/false appuser && \
    mkdir -p /home/appuser && \
    chown appuser:appgroup /home/appuser

# Copy venv from builder
COPY --from=builder /usr/src/.venv /usr/src/.venv

# Copy application
COPY src /usr/src/src

# Fix ownership
RUN chown -R appuser:appgroup /usr/src

USER appuser

CMD [ "gunicorn", \
      "-b", "0.0.0.0:8000", \
      "--workers", "3", \
      "--timeout", "60", \
      "--graceful-timeout", "30", \
      "--keep-alive", "5", \
      "--access-logfile", "-", \
      "--error-logfile", "-", \
      "--log-level", "info", \
      "src.app:create_app()" ]


